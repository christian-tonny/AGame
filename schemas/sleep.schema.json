{
 "$id": "agame/sleep.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "properties": {
  "as_of": {
   "format": "date-time",
   "type": [
    "string",
    "null"
   ]
  },
  "coverage": {
   "additionalProperties": false,
   "properties": {
    "expected": {
     "type": [
      "integer",
      "null"
     ]
    },
    "ratio": {
     "type": [
      "number",
      "null"
     ]
    },
    "received": {
     "type": [
      "integer",
      "null"
     ]
    }
   },
   "type": [
    "object",
    "null"
   ]
  },
  "domain": {
   "const": "sleep"
  },
  "fixture": {
   "enum": [
    false,
    "empty",
    "synthetic"
   ]
  },
  "generated_at": {
   "format": "date-time",
   "type": [
    "string",
    "null"
   ]
  },
  "nights": {
   "items": {
    "additionalProperties": false,
    "anyOf": [
     {
      "required": [
       "segments"
      ]
     },
     {
      "required": [
       "stage_minutes"
      ]
     }
    ],
    "description": "One sleep session. Either segments (the stage timeline) or stage_minutes (totals from a summary source).",
    "properties": {
     "awakenings": {
      "minimum": 0,
      "type": [
       "integer",
       "null"
      ]
     },
     "date": {
      "format": "date",
      "type": "string"
     },
     "efficiency_pct": {
      "maximum": 100,
      "minimum": 0,
      "type": [
       "number",
       "null"
      ]
     },
     "end": {
      "format": "date-time",
      "type": "string"
     },
     "is_nap": {
      "type": "boolean"
     },
     "partial": {
      "type": "boolean"
     },
     "segments": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "end": {
         "format": "date-time",
         "type": "string"
        },
        "stage": {
         "enum": [
          "in_bed",
          "awake",
          "core",
          "deep",
          "rem",
          "asleep_unspecified"
         ]
        },
        "start": {
         "format": "date-time",
         "type": "string"
        }
       },
       "required": [
        "stage",
        "start",
        "end"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "source": {
      "type": [
       "string",
       "null"
      ]
     },
     "source_id": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "stage_minutes": {
      "additionalProperties": false,
      "properties": {
       "asleep_unspecified": {
        "minimum": 0,
        "type": [
         "number",
         "null"
        ]
       },
       "awake": {
        "minimum": 0,
        "type": [
         "number",
         "null"
        ]
       },
       "core": {
        "minimum": 0,
        "type": [
         "number",
         "null"
        ]
       },
       "deep": {
        "minimum": 0,
        "type": [
         "number",
         "null"
        ]
       },
       "in_bed": {
        "minimum": 0,
        "type": [
         "number",
         "null"
        ]
       },
       "rem": {
        "minimum": 0,
        "type": [
         "number",
         "null"
        ]
       }
      },
      "type": "object"
     },
     "start": {
      "format": "date-time",
      "type": "string"
     },
     "synced_at": {
      "format": "date-time",
      "type": "string"
     }
    },
    "required": [
     "source_id",
     "start",
     "end"
    ],
    "type": "object"
   },
   "type": "array"
  },
  "notes": {
   "items": {
    "type": "string"
   },
   "type": "array"
  },
  "schema_version": {
   "pattern": "^\\d+\\.\\d+\\.\\d+$",
   "type": "string"
  },
  "source": {
   "type": [
    "string",
    "null"
   ]
  },
  "status": {
   "enum": [
    "ok",
    "partial",
    "stale",
    "missing"
   ]
  }
 },
 "required": [
  "schema_version",
  "domain",
  "generated_at",
  "as_of",
  "source",
  "status",
  "nights"
 ],
 "title": "AGame sleep",
 "type": "object"
}
