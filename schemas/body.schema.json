   "type": "array"
  },
  "notes": {
   "items": {
    "type": "string"
   },
   "type": "array"
  },
  "schema_version": {
   "pattern": "^\\d+\\.\\d+\\.\\d+$",
   "type": "string"
  },
  "source": {
   "type": [
    "string",
    "null"
   ]
  },
  "status": {
