      "type": [
       "string",
       "null"
      ]
     },
     "source_id": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "t": {
      "format": "date-time",
      "type": "string"
     },
     "type": {
      "enum": [
       "weight_kg",
       "body_fat_pct",
       "lean_mass_kg",
       "waist_cm",
       "bmi",
       "bp_systolic_mmhg",
       "bp_diastolic_mmhg"
      ]
     },
     "v": {
      "minimum": 0,
      "type": "number"
     }
    },
    "required": [
     "t",
     "type",
     "v",
     "source_id"
