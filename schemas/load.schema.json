{
 "$id": "agame/load.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "properties": {
  "annotations": {
   "items": {
    "additionalProperties": false,
    "properties": {
     "comment": {
      "type": [
       "string",
       "null"
      ]
     },
     "created_at": {
      "format": "date-time",
      "type": [
       "string",
       "null"
      ]
     },
     "feel": {
      "maximum": 5,
      "minimum": 1,
      "type": [
       "integer",
       "null"
      ]
     },
     "id": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "private": {
      "type": "boolean"
     },
     "race": {
      "type": "boolean"
     },
     "rpe": {
      "maximum": 10,
      "minimum": 1,
      "type": [
       "number",
       "null"
      ]
     },
     "tags": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "title": {
      "type": [
       "string",
       "null"
      ]
     },
     "updated_at": {
      "format": "date-time",
      "type": [
       "string",
       "null"
      ]
     },
     "workout_id": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "id",
     "workout_id"
    ],
    "type": "object"
   },
   "type": "array"
  },
  "as_of": {
   "format": "date-time",
   "type": [
    "string",
    "null"
   ]
  },
  "coverage": {
   "additionalProperties": false,
   "properties": {
    "expected": {
     "type": [
      "integer",
      "null"
     ]
    },
    "ratio": {
     "type": [
      "number",
      "null"
     ]
    },
    "received": {
     "type": [
      "integer",
      "null"
     ]
    }
   },
   "type": [
    "object",
    "null"
   ]
  },
  "domain": {
   "const": "load"
  },
  "fixture": {
   "enum": [
    false,
    "empty",
    "synthetic"
   ]
  },
  "generated_at": {
   "format": "date-time",
   "type": [
    "string",
    "null"
   ]
  },
  "notes": {
   "items": {
    "type": "string"
   },
   "type": "array"
  },
  "schema_version": {
   "pattern": "^\\d+\\.\\d+\\.\\d+$",
   "type": "string"
  },
  "source": {
   "type": [
    "string",
    "null"
   ]
  },
  "status": {
   "enum": [
    "ok",
    "partial",
    "stale",
    "missing"
   ]
  }
 },
 "required": [
  "schema_version",
  "domain",
  "generated_at",
  "as_of",
  "source",
  "status",
  "annotations"
 ],
 "title": "AGame load",
 "type": "object"
}
