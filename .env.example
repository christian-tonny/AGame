# Names only. Never commit values.

# Where the private data files live (default: ./data, which holds empty fixtures only)
AGAME_DATA_DIR=
# Where builds are written (default: ./dist)
AGAME_DIST_DIR=

# Owner sign-in (OpenID Connect; Google by default)
AGAME_OIDC_ISSUER=
AGAME_OIDC_CLIENT_ID=
AGAME_OIDC_CLIENT_SECRET=
AGAME_OWNER_EMAIL=
AGAME_SESSION_SECRET=
AGAME_BASE_URL=

# Snapshot upload from Steve (bearer token for POST /api/snapshot)
AGAME_UPLOAD_TOKEN=

# Optional Coach chat (server-side only)
AGAME_LLM_PROVIDER=
AGAME_LLM_MODEL=
ANTHROPIC_API_KEY=

# Server
PORT=
