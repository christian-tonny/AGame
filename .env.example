# Names only. Never commit values.

# Where the private data files live (default: ./data, which holds empty fixtures only)
AGAME_DATA_DIR=
# Where builds are written (default: ./dist)
AGAME_DIST_DIR=

# Owner sign-in: a passphrase hash (python3 -m agame.auth hash-passphrase), and/or Google OpenID Connect (all three OIDC names)
AGAME_OWNER_PASSPHRASE_HASH=
AGAME_OIDC_ISSUER=
AGAME_OIDC_CLIENT_ID=
AGAME_OIDC_CLIENT_SECRET=
AGAME_OWNER_EMAIL=
AGAME_SESSION_SECRET=
AGAME_BASE_URL=

# The agent (Muse): imports, reads and logs over HTTP with Authorization: Bearer <token>. See docs/agents.md
AGAME_AGENT_TOKEN=
# Optional: extra agent credentials as comma-separated SHA-256 hashes (never the values), for a platform that sends its own stand-in
AGAME_AGENT_TOKEN_HASHES=

# Whole-folder snapshot push (bearer token for POST /api/snapshot); agents use AGAME_AGENT_TOKEN instead
AGAME_UPLOAD_TOKEN=

# Optional Coach chat (server-side only)
AGAME_LLM_PROVIDER=
AGAME_LLM_MODEL=
ANTHROPIC_API_KEY=

# Server
PORT=
